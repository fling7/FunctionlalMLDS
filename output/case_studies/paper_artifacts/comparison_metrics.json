{
  "schema": "functionalmlds_case_study_comparison_metrics",
  "schema_version": "1.0",
  "purpose": "Define fair comparison metrics for Baseline A and Treatment B.",
  "baseline_id": "baseline_a_direct_mldsi_to_interactive_agents",
  "treatment_id": "treatment_b_functionalmlds_mediated_generation",
  "value_kinds": {
    "measured": "Value is already measured by generated reports.",
    "explicit_absence": "Baseline artifact does not contain the first-class construct required by the metric.",
    "requires_baseline_run": "Metric can be computed after running Baseline A on the same corpus.",
    "protocol_defined": "Metric is defined, but requires a targeted follow-up experiment."
  },
  "metrics": [
    {
      "metric_id": "M1_explicit_model_artifact_presence",
      "rq": "RQ1",
      "dimension": "traceability",
      "question": "Does the pipeline produce an explicit intermediate metamodel instance?",
      "formula": "count(cases_with_functionalmlds_instance) / count(cases)",
      "baseline_value_kind": "explicit_absence",
      "baseline_expected_value": 0.0,
      "treatment_value_kind": "measured",
      "treatment_current_value": 1.0,
      "treatment_source": "stage_completion_report and functionalmlds/functionalmlds.instance.generated.json"
    },
    {
      "metric_id": "M2_average_trace_coverage",
      "rq": "RQ1",
      "dimension": "traceability",
      "question": "How much of the required trace chain is represented by explicit artefacts?",
      "formula": "mean(traceability_metrics.coverage)",
      "baseline_value_kind": "explicit_absence",
      "baseline_expected_value": 0.0,
      "treatment_value_kind": "measured",
      "treatment_current_value": 0.847222,
      "treatment_source": "output/case_studies/aggregate_report.json::cross_case_metrics.metrics.average_trace_coverage"
    },
    {
      "metric_id": "M3_requirement_to_validation_coverage",
      "rq": "RQ1",
      "dimension": "traceability",
      "question": "Are modelled requirements connected to validation cases or runtime checks?",
      "formula": "requirements_with_validation_link / requirements_total",
      "baseline_value_kind": "explicit_absence",
      "baseline_expected_value": 0.0,
      "treatment_value_kind": "measured",
      "treatment_current_value": 1.0,
      "treatment_source": "cross_case_metrics.metrics.average_requirement_to_validation_coverage"
    },
    {
      "metric_id": "M4_object_group_to_agent_grounding",
      "rq": "RQ1",
      "dimension": "traceability",
      "question": "Are semantic object groups grounded in generated agent roles and knowledge scopes?",
      "formula": "covered_object_groups / relevant_object_groups",
      "baseline_value_kind": "requires_baseline_run",
      "baseline_expected_value": null,
      "treatment_value_kind": "measured",
      "treatment_current_value": 1.0,
      "treatment_source": "cross_case_metrics.metrics.average_object_group_coverage"
    },
    {
      "metric_id": "M5_schema_and_invariant_success",
      "rq": "RQ2",
      "dimension": "consistency",
      "question": "Do generated metamodel artefacts satisfy schema and invariant checks?",
      "formula": "successful_schema_and_invariant_cases / cases",
      "baseline_value_kind": "explicit_absence",
      "baseline_expected_value": 0.0,
      "treatment_value_kind": "measured",
      "treatment_current_value": 1.0,
      "treatment_source": "schema_validation and functionalmlds_invariants stage reports"
    },
    {
      "metric_id": "M6_invalid_handoff_target_count",
      "rq": "RQ2",
      "dimension": "consistency",
      "question": "How many handoff links point to unknown or invalid target agents?",
      "formula": "count(invalid_handoff_targets)",
      "baseline_value_kind": "requires_baseline_run",
      "baseline_expected_value": null,
      "treatment_value_kind": "measured",
      "treatment_current_value": 0,
      "treatment_source": "validation/handoff_metrics.json and validation/agent_roles_validation.json"
    },
    {
      "metric_id": "M7_missing_knowledge_tag_count",
      "rq": "RQ2",
      "dimension": "consistency",
      "question": "How many generated agent knowledge tags are not backed by generated knowledge entries?",
      "formula": "count(agent_knowledge_tags_without_knowledge_entry)",
      "baseline_value_kind": "requires_baseline_run",
      "baseline_expected_value": null,
      "treatment_value_kind": "measured",
      "treatment_current_value": 0,
      "treatment_source": "validation/knowledge_synthesis_validation.json"
    },
    {
      "metric_id": "M8_unbound_capability_count",
      "rq": "RQ2",
      "dimension": "consistency",
      "question": "How many modelled capabilities lack an executable or inspectable runtime binding?",
      "formula": "count(capabilities_without_runtime_binding)",
      "baseline_value_kind": "explicit_absence",
      "baseline_expected_value": null,
      "treatment_value_kind": "measured",
      "treatment_current_value": 0,
      "treatment_source": "functionalmlds_invariant_validation.json"
    },
    {
      "metric_id": "M9_handoff_decision_accuracy",
      "rq": "RQ2",
      "dimension": "runtime_checkability",
      "question": "Do generated agents hand off to the expected target when prompted with role-specific questions?",
      "formula": "correct_handoff_decisions / handoff_decision_tests",
      "baseline_value_kind": "requires_baseline_run",
      "baseline_expected_value": null,
      "treatment_value_kind": "measured",
      "treatment_current_value": 1.0,
      "treatment_source": "cross_case_metrics.metrics.average_handoff_accuracy"
    },
    {
      "metric_id": "M10_answer_grounding_ratio",
      "rq": "RQ2",
      "dimension": "runtime_checkability",
      "question": "Are runtime answers grounded in the expected agent and scene context?",
      "formula": "grounded_answers / executed_chat_tests",
      "baseline_value_kind": "requires_baseline_run",
      "baseline_expected_value": null,
      "treatment_value_kind": "measured",
      "treatment_current_value": 1.0,
      "treatment_source": "cross_case_metrics.metrics.average_answer_grounding_ratio"
    },
    {
      "metric_id": "M11_stage_completion_ratio",
      "rq": "RQ2",
      "dimension": "repairability",
      "question": "Can the pipeline complete all required stages with valid output reports?",
      "formula": "completed_valid_stages / required_stages",
      "baseline_value_kind": "explicit_absence",
      "baseline_expected_value": 0.0,
      "treatment_value_kind": "measured",
      "treatment_current_value": 1.0,
      "treatment_source": "cross_case_metrics.metrics.average_stage_completion_ratio"
    },
    {
      "metric_id": "M12_repair_attempt_count",
      "rq": "RQ2",
      "dimension": "repairability",
      "question": "How many bounded LLM repair attempts were needed after an invalid generated artefact?",
      "formula": "count(repair_log.entries where repair_type == 'llm_repair_attempt')",
      "baseline_value_kind": "explicit_absence",
      "baseline_expected_value": null,
      "treatment_value_kind": "measured",
      "treatment_current_value": 0,
      "treatment_source": "output/case_studies/repair_log_summary.json::metrics.llm_repair_attempt_count"
    },
    {
      "metric_id": "M13_generalizability_score",
      "rq": "RQ3",
      "dimension": "generalizability",
      "question": "Does the same pipeline work over multiple MLDS domains without domain-specific Python code?",
      "formula": "passed_generalizability_checks / total_generalizability_checks",
      "baseline_value_kind": "protocol_defined",
      "baseline_expected_value": null,
      "treatment_value_kind": "measured",
      "treatment_current_value": 1.0,
      "treatment_source": "generalizability_assessment.json::metrics.generalizability_score"
    },
    {
      "metric_id": "M14_domain_term_externalization",
      "rq": "RQ3",
      "dimension": "generalizability",
      "question": "Are domain-specific terms externalized from pipeline code?",
      "formula": "1 if code_scan.finding_count == 0 else 0",
      "baseline_value_kind": "protocol_defined",
      "baseline_expected_value": null,
      "treatment_value_kind": "measured",
      "treatment_current_value": 1.0,
      "treatment_source": "generalizability_assessment.json::domain_terms_externalized"
    },
    {
      "metric_id": "M15_runtime_binding_substitution_locality",
      "rq": "RQ2",
      "dimension": "maintainability",
      "question": "Can a runtime binding be exchanged without editing the scenario structure?",
      "formula": "count(changed_scenario_elements_after_binding_substitution)",
      "baseline_value_kind": "explicit_absence",
      "baseline_expected_value": null,
      "treatment_value_kind": "protocol_defined",
      "treatment_current_value": null,
      "treatment_source": "future targeted maintainability experiment"
    }
  ]
}
