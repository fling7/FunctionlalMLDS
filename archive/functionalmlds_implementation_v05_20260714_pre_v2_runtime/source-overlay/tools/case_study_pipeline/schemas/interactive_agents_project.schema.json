{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InteractiveAgentsProjectFiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "agents", "room_plan", "trace_map"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "display_name", "description", "created_ms", "updated_ms"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "created_ms": { "type": "integer" },
        "updated_ms": { "type": "integer" },
        "generation_mode": { "type": "string" },
        "functionalmlds_trace_path": { "type": "string" },
        "functionalmlds_case_dir": { "type": "string" },
        "source_mlds_path": { "type": "string" },
        "metamodelVersion": { "type": "string" }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": true,
      "required": ["agents"],
      "properties": {
        "agents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "display_name", "persona", "expertise", "knowledge_tags", "position", "forward"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "display_name": { "type": "string", "minLength": 1 },
              "persona": { "type": "string" },
              "expertise": { "type": "array", "items": { "type": "string" } },
              "knowledge_tags": { "type": "array", "items": { "type": "string" } },
              "responsible_zone_ids": { "type": "array", "items": { "type": "string" } },
              "grounded_object_ids": { "type": "array", "items": { "type": "string" } },
              "handoff_targets": { "type": "array", "items": { "type": "string" } },
              "preferred_zone_ids": { "type": "array", "items": { "type": "string" } },
              "position": { "$ref": "#/$defs/vector3" },
              "forward": { "$ref": "#/$defs/vector3" },
              "voice": { "type": ["string", "null"] },
              "voice_gender": { "type": ["string", "null"] },
              "voice_style": { "type": ["string", "null"] },
              "tts_model": { "type": ["string", "null"] },
              "functionalmlds_agent_ref": { "type": "string" }
            }
          }
        }
      }
    },
    "room_plan": {
      "type": "object",
      "additionalProperties": true,
      "required": ["scene"],
      "properties": {
        "scene": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "trace_map": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema",
        "case_id",
        "functionalmlds_path",
        "project_files",
        "scenario_steps",
        "capabilities",
        "runtime_actions",
        "validation_cases",
        "agents"
      ],
      "properties": {
        "schema": { "type": "string", "const": "functionalmlds_trace_map" },
        "case_id": { "type": "string", "minLength": 1 },
        "functionalmlds_path": { "type": "string" },
        "project_files": { "type": "object" },
        "scenario_steps": { "type": "array", "minItems": 1 },
        "capabilities": { "type": "array", "minItems": 1 },
        "runtime_actions": { "type": "array", "minItems": 1 },
        "validation_cases": { "type": "array", "minItems": 1 },
        "agents": { "type": "array", "minItems": 1 }
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "object",
      "additionalProperties": true,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    }
  }
}
