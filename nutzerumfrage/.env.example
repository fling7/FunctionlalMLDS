# Change this before collecting responses. The server refuses common defaults.
SURVEY_ADMIN_PIN=replace-with-a-long-private-pin

# Optional runtime settings
SURVEY_API_PORT=3001
SURVEY_HTTPS_PORT=3443
SURVEY_DB_PATH=./data/survey.sqlite
SURVEY_TLS_KEY=./keys/localhost-key.pem
SURVEY_TLS_CERT=./keys/localhost-cert.pem
